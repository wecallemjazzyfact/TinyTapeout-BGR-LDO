C {code_shown.sym} 420 -910 0 0 {name=SIM_CONTROL only_toplevel=false 
value=".nodeset v(vbe1)=0.78 v(net1)=0.78 v(v_mid1)=1.95 v(v_gate_top)=2.14 v(v_bias)=1.82 v(v_bias_n)=0.91
.save all
.dc temp -40 125 5

.control
  run
  write bgr_core_tb.raw
  plot v(vref_low)
  plot v(vbe1)-v(net1)
  echo =========================================================
  echo  BGR Core DC Operating Point (27 C)
  echo =========================================================
  print v(vref_low)
  print v(vbe1) v(net1) (v(vbe1)-v(net1))
  print v(v_mid1) v(v_gate_top) v(v_bias)
  print @m.xxm_top1.msky130_fd_pr__pfet_g5v0d10v5[id] @m.xxm_top2.msky130_fd_pr__pfet_g5v0d10v5[id] @m.xxm_top5.msky130_fd_pr__pfet_g5v0d10v5[id]
.endc"}
